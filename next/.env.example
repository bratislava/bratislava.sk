# To start developing, copy this into .env.local
# All NEXT_PUBLIC_* variables listed here are asserted in src/environment.ts, they must not be empty.

NEXT_PUBLIC_DEPLOYMENT=dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Strapi (see strapi/README.md for how to restore a database dump)
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Alternative: run against the deployed Strapi
# NEXT_PUBLIC_STRAPI_URL=https://bratislava-strapi.staging.bratislava.sk

# Must match REVALIDATE_SECRET_TOKEN in strapi/.env.local
REVALIDATE_SECRET_TOKEN=<see-readme>

# Meilisearch — use "Default Search API Key", see the Meilisearch section in the root README.md
NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_API_KEY=<see-readme>
# Alternative: run against the deployed Meilisearch
# NEXT_PUBLIC_MEILISEARCH_HOST=https://bratislava-strapi-meilisearch.staging.bratislava.sk/
# NEXT_PUBLIC_MEILISEARCH_SEARCH_API_KEY=05db97318a2a244b7e0f6613bbb16ad3e4d28452e956f06c1f3466d5e1b4669a

# Google Tag Manager — keep the placeholders unless you need to test GTM locally, the values must not be empty
NEXT_PUBLIC_GTM_ID=GTM-5XFFHW6M
NEXT_PUBLIC_GTM_AUTH=<contact-PM-if-needed>
NEXT_PUBLIC_GTM_PREVIEW=<contact-PM-if-needed>

# Official board (úradná tabuľa)
GINIS_HOST_UDE=https://ginis-wso.bratislava.sk/gordic/ginis/ws/UDE01/Ude.svc
GINIS_USERNAME=<contact-PM-if-needed>
GINIS_PASSWORD=<contact-PM-if-needed>

# Microsoft Graph (MSAL)
MSAL_CLIENT_ID=a6f86f77-53f7-4a8c-a1e8-06671a2395b8
MSAL_CLIENT_SECRET=<contact-PM-if-needed>
MSAL_SCOPE=https://graph.microsoft.com/.default
MSAL_TENANT_ID=fe69e74e-1e66-4fcb-99c5-58e4a2d2a063

# City account (konto.bratislava.sk) - use in content-inventory api endpoint
CITY_ACCOUNT_STRAPI_URL=https://city-account-strapi.staging.bratislava.sk
CITY_ACCOUNT_URL=https://city-account-next.staging.bratislava.sk

# STaZ Newsletter
STARZ_ECOMAIL_API_KEY=<contact-PM-if-needed>

# Job offers from Nalgoo (pracovné príležitosti)
NALGOO_API_KEY=<contact-PM-if-needed>

# Content inventory api endpoint (/api/content-inventory), sent by its consumers as `Authorization: Bearer <key>`
CONTENT_INVENTORY_API_KEY=<contact-PM-if-needed>

# Feature flags
NEXT_PUBLIC_FEATURE_FLAG_RSS_FEED=true
NEXT_PUBLIC_FEATURE_FLAG_GTRANSLATE=false
NEXT_PUBLIC_FEATURE_FLAG_COOKIE_CONSENT_GATE=true
NEXT_PUBLIC_FEATURE_FLAG_CONTENT_INVENTORY=true
