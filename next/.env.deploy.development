# Non-secret env for the development cluster, read at deploy time by
# infrastructure-deployment-configuration and turned into the app ConfigMap.
# Every value must fit on a single line: no line continuation, no escapes.
# Secrets live in Passbolt, never here - as does anything multiline.

NODE_OPTIONS=--max-old-space-size=7000
NODE_ENV=production
# Server-side fetches go to the Strapi service in the same namespace.
NEXT_PUBLIC_STRAPI_URL=bratislava-strapi-app

# Server-only, also in .env.build.development because prerendering at build time reads them.
GINIS_HOST_UDE=https://ginis-wso.bratislava.sk/gordic/ginis/ws/UDE01/Ude.svc
CITY_ACCOUNT_STRAPI_URL=https://city-account-strapi.dev.bratislava.sk
CITY_ACCOUNT_URL=https://city-account-next.dev.bratislava.sk
MSAL_CLIENT_ID=a6f86f77-53f7-4a8c-a1e8-06671a2395b8
MSAL_SCOPE=https://graph.microsoft.com/.default
MSAL_TENANT_ID=fe69e74e-1e66-4fcb-99c5-58e4a2d2a063
