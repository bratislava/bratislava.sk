{
  "name": "bratislava-next",
  "version": "1.5.0",
  "private": true,
  "license": "EUPL-1.2",
  "scripts": {
    "dev": "next dev",
    "develop": "npm run dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc",
    "lint": "eslint src",
    "lint:fix": "npm run lint -- --fix",
    "lint:quiet": "npm run lint -- --quiet",
    "gen": "graphql-codegen && prettier --write src/services/graphql/index.ts",
    "prettier": "prettier --write .",
    "parse-translations": "i18next-cli extract",
    "postbuild": "tsc --p tsconfig.sitemap.json && tsc-alias -p tsconfig.sitemap.json && next-sitemap --config next-sitemap.config.js",
    "update-i18next": "npm install next-i18next@latest react-i18next@latest i18next@latest --save-exact && npm install i18next-cli@latest --save-dev --save-exact",
    "update-markdown": "npm install remark-directive@latest remark-directive-rehype@latest remark-gfm@latest remark-supersub@latest",
    "update-next": "npm install next@latest @next/third-parties@latest react@latest react-dom@latest sharp@latest --save-exact && npm install @types/react@latest @types/react-dom@latest typescript@latest --save-dev --save-exact",
    "update-react-aria": "npm install @internationalized/date@latest react-aria@latest react-aria-components@latest react-stately@latest tailwindcss-react-aria-components --save-exact",
    "update-tailwind": "npm install tailwind-merge@latest clsx@latest --save-exact && npm install tailwindcss@latest postcss@latest prettier-plugin-tailwindcss@latest --save-dev --save-exact",
    "update-prettier": "npm install prettier@latest --save-dev --save-exact",
    "update-graphql": "npm install graphql@latest graphql-request@latest graphql-tag@latest --save-exact && npm install @graphql-codegen/cli@latest @graphql-codegen/typescript@latest @graphql-codegen/typescript-operations@latest @graphql-codegen/typescript-graphql-request@latest --save-dev --save-exact",
    "update-radix": "npm install @radix-ui/react-navigation-menu@latest --save-exact",
    "update-react-query": "npm install @tanstack/react-query@latest --save-exact",
    "update-typescript": "npm install typescript@latest --save-dev --save-exact"
  },
  "dependencies": {
    "@azure/msal-node": "5.5.0",
    "@bratislava/component-library": "1.1.3",
    "@bratislava/ginis-sdk": "2.2.1",
    "@hookform/resolvers": "5.4.0",
    "@iframe-resizer/react": "5.5.9",
    "@internationalized/date": "3.12.2",
    "@next/third-parties": "16.3.0",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@sindresorhus/slugify": "3.0.0",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.19.0",
    "clsx": "2.1.1",
    "dotenv": "17.4.2",
    "focus-trap-react": "12.0.3",
    "framer-motion": "12.43.0",
    "graphql": "16.14.1",
    "graphql-request": "7.4.0",
    "graphql-tag": "2.12.7",
    "i18next": "26.3.1",
    "lodash": "4.18.1",
    "meilisearch": "0.30.0",
    "next": "16.3.0",
    "next-i18next": "16.0.7",
    "next-plausible": "3.12.5",
    "next-sitemap": "4.2.3",
    "nuqs": "2.9.5",
    "pretty-bytes": "7.1.1",
    "react": "19.2.8",
    "react-aria": "3.49.0",
    "react-aria-components": "1.18.0",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "react-i18next": "17.0.8",
    "react-markdown": "10.1.0",
    "react-resize-detector": "12.3.0",
    "react-stately": "3.47.0",
    "remark-directive": "4.0.0",
    "remark-directive-rehype": "0.4.2",
    "remark-gfm": "4.0.1",
    "remark-supersub": "1.0.0",
    "remark-unwrap-images": "4.0.1",
    "rss": "1.2.2",
    "tailwind-merge": "3.6.0",
    "tailwind-scrollbar-hide": "4.0.0",
    "tailwindcss-animate": "1.0.7",
    "tailwindcss-react-aria-components": "2.1.1",
    "usehooks-ts": "3.1.1",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@bratislava/eslint-config-next": "0.14.0",
    "@graphql-codegen/cli": "5.0.7",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-graphql-request": "6.2.1",
    "@graphql-codegen/typescript-operations": "4.6.0",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/cookiebot-sdk": "2.43.5",
    "@types/lodash": "4.17.25",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/rss": "0.0.32",
    "eslint": "9.39.1",
    "i18next-cli": "1.61.0",
    "postcss": "8.5.25",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sass": "1.62.1",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.1",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=24.16.x",
    "npm": ">=11.13.x"
  },
  "volta": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
