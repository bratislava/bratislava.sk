# Non-secret env for the development cluster, read at deploy time by
# infrastructure-deployment-configuration and turned into the app ConfigMap.
# Every value must fit on a single line: no line continuation, no escapes.
# Secrets live in Passbolt, never here - as does anything multiline.

NODE_OPTIONS=--max-old-space-size=7000
NODE_ENV=production
STRAPI_URL=https://bratislava-strapi.dev.bratislava.sk
REVALIDATE_NEXT_URL=http://bratislava-next-app

MINIO_BUCKET=bratislavask
MINIO_PRIVATE_ENDPOINT=https://s3.bratislava.sk
MINIO_PUBLIC_ENDPOINT=https://bratislavask.s3.bratislava.sk

STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=sk

MAILGUN_DOMAIN=no-reply-strapi.bratislava.sk
MAILGUN_EMAIL=info@no-reply-strapi.bratislava.sk
